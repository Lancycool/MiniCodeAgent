# 复制本文件为 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）
MCA_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
MCA_LLM_BASE_URL=https://api.deepseek.com
MCA_LLM_MODEL=deepseek-v4.1-flash
